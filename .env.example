# Copy this file to .env (or .env.local) and fill in a key to use the real
# LLM evaluator. Without any key, the app runs on FakeEvaluator automatically
# — it's fully demoable with zero setup, just with heuristic (not LLM) feedback.

# Preferred: Groq — free tier, no card required, OpenAI-compatible API.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# Force the fake evaluator even if a key is set (useful for demos you don't
# want to spend API calls on, or offline).
USE_FAKE_EVALUATOR=false
